{
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "types": [
      "bun",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "scripts/dockerfiles.ts",
    "scripts/scan-postgres-versions.ts",
    "scripts/lib/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
